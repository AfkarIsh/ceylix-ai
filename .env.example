# Ceylix AI Environment Configuration Example
# Copy this file to .env and configure your keys

# Google Gemini API Key (Direct)
GEMINI_API_KEY=

# Or OpenRouter API Key (Alternative for Gemini models)
OPENROUTER_API_KEY=

# Model identifier
GEMINI_MODEL=google/gemini-2.5-flash

# Cloud settings (Optional)
GOOGLE_CLOUD_PROJECT=
FIRESTORE_COLLECTION=cases
PORT=8000
